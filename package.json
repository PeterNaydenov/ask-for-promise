{
  "name": "ask-for-promise",
  "description": "promise utility library",
  "version": "3.2.2",
  "license": "MIT",
  "author": "Peter Naydenov",
  "main": "src/askForPromise.js",
  "type": "module",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.ts",
        "default": "./src/askForPromise.js"
      },
      "require": {
        "types": "./types/index.d.cts",
        "default": "./dist/ask-for-promise.cjs"
      },
      "default": "./src/askForPromise.js"
    },
    "./package.json": "./package.json",
    "./src/*": "./src/*",
    "./dist/*": "./dist/*",
    "./types/*": "./types/*"
  },
  "files": [
    "src/*.js",
    "dist/*",
    "types/*",
    "skills/**",
    "Ask-for-promise.png",
    "Changelog.md",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "test": "mocha --node-option=unhandled-rejections=strict test",
    "cover": "c8 mocha --node-option=unhandled-rejections=strict test",
    "build": "tsc --noEmit && vite build",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeterNaydenov/ask-for-promise.git"
  },
  "homepage": "https://github.com/PeterNaydenov/ask-for-promise#readme",
  "bugs": {
    "url": "https://github.com/PeterNaydenov/ask-for-promise/issues"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "chai": "6.3.0",
    "mocha": "^12.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "directories": {
    "test": "test"
  },
  "c8": {
    "include": [
      "src/**/*.js"
    ],
    "exclude": [
      "node_modules",
      "test"
    ],
    "reporter": [
      "lcov",
      "text-summary"
    ]
  },
  "keywords": [
    "promise",
    "sequence",
    "parallel",
    "timeout",
    "ttl",
    "decoupled promise"
  ],
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
