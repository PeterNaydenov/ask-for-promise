{
    "include": ["./src/**/*", "./types/**/*", "./test/types/**/*"],
    "compilerOptions": {
      "allowJs": true,
      "checkJs": true,
      "declaration": false,
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": false,
      "forceConsistentCasingInFileNames": true,
      "moduleResolution": "nodenext",
      "target": "ES2021",
      "module": "nodenext"
    }
  }
